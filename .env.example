# Telegram bot token from @BotFather
BOT_TOKEN=123456789:PASTE_YOUR_BOT_TOKEN_HERE

# Public HTTPS URL of the app.
# Local Cloudflare example: https://abc123.trycloudflare.com
# Railway example: https://your-service.up.railway.app
WEBAPP_URL=https://your-domain.com

# Optional: bot username without @, used for invite links
BOT_USERNAME=ChessMeetMinskBot

# MVP polling mode. Keep polling on Railway unless you later switch to webhooks.
BOT_MODE=polling

# Public deployment must be false.
DEV_MODE=false

# Local default:
# DATABASE_PATH=./chess_irl.sqlite3
# Railway + Volume default. Mount Railway volume at /data.
DATABASE_PATH=/data/chess_irl.sqlite3

# Default city for MVP
DEFAULT_CITY=Минск

# Required for protected admin endpoints and Remote Admin Client.
# Generate a long random value and keep it secret.
ADMIN_TOKEN=change_me_to_a_long_random_secret

# Optional local remote admin client helper
ADMIN_API_URL=https://your-railway-domain.up.railway.app
